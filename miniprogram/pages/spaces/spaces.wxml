<view class="page">
  <view class="row">
    <view>
      <view class="title">我的空间</view>
      <view class="subtitle">选择一个饭局空间继续。</view>
    </view>
  </view>

  <view class="section-title">已加入</view>
  <view wx:for="{{spaces}}" wx:key="_id" class="card" bindtap="openSpace" data-id="{{item._id}}">
    <view class="row">
      <view>
        <view class="section-title compact">{{item.name}}</view>
        <view class="muted">{{item.description}}</view>
      </view>
      <view class="tag">{{item.currency_name}}</view>
    </view>
    <view class="muted">邀请码 {{item.invite_code}}</view>
  </view>

  <view class="section-title">创建空间</view>
  <view class="card stack">
    <input class="input" value="{{newSpaceName}}" placeholder="空间名称，例如 周末饭局" bindinput="handleNewSpaceName" />
    <input class="input" value="{{newSpaceDescription}}" placeholder="空间描述" bindinput="handleNewSpaceDescription" />
    <input class="input" value="{{currencyName}}" placeholder="虚拟货币名称，默认饭票" bindinput="handleCurrencyName" />
  </view>

  <view class="section-title">加入空间</view>
  <view class="card">
    <input class="input" value="{{inviteCode}}" placeholder="输入邀请码" bindinput="handleInviteCode" />
  </view>

  <view class="footer-actions">
    <button class="button secondary" bindtap="createSpace">创建空间</button>
    <button class="button secondary" bindtap="joinSpace">加入空间</button>
  </view>
</view>
