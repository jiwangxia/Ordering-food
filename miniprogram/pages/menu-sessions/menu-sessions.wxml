<view class="page">
  <view class="title">点单局</view>
  <view class="subtitle">同一个空间可以同时有多个点单局。</view>

  <view class="section-title">进行中</view>
  <view wx:for="{{sessions}}" wx:key="_id" class="card" bindtap="openSession" data-id="{{item._id}}">
    <view class="row">
      <view>
        <view class="session-name">{{item.name}}</view>
        <view class="muted">{{item.description}}</view>
      </view>
      <view class="tag">{{item.statusText}}</view>
    </view>
  </view>

  <view class="footer-actions">
    <button class="button">创建点单局</button>
  </view>
</view>
