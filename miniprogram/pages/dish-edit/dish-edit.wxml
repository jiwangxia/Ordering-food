<view class="page">
  <view class="title">新增菜品</view>
  <view class="stack">
    <input class="input" placeholder="菜名" />
    <input class="input" type="number" placeholder="虚拟价格" />
    <input class="input" placeholder="食材，用顿号或逗号分隔" />
    <textarea class="textarea" placeholder="做法描述"></textarea>
    <button class="button secondary">选择图片</button>
  </view>
  <view class="footer-actions">
    <button class="button" bindtap="saveDish">保存到菜品库</button>
  </view>
</view>
